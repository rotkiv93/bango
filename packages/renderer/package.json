{
  "name": "@bango/renderer",
  "version": "0.1.0",
  "description": "Framework-agnostic renderers (text, form, diagram, AST) for Bango model instances",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotkiv93/bango.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/rotkiv93/bango/tree/main/packages/renderer#readme",
  "bugs": {
    "url": "https://github.com/rotkiv93/bango/issues"
  },
  "keywords": [
    "bango",
    "metamodel",
    "editor",
    "diagram",
    "monaco"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/views/text/index.d.ts",
      "import": "./dist/text.js"
    },
    "./bundle": "./dist/bundle/renderer.js"
  },
  "peerDependencies": {
    "@bango/core": "^0.1.0",
    "monaco-editor": "^0.57.0",
    "elkjs": "^0.12.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    },
    "elkjs": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build && vite build -c vite.bundle.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": {
    "node": ">=20"
  }
}
