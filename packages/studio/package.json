{
  "name": "@bango/studio",
  "version": "0.1.0",
  "private": true,
  "description": "A framework-agnostic workbench to write a Bango metamodel: grammar and script editors, tests, composed grammar, AST and a live preview of an instance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotkiv93/bango.git",
    "directory": "packages/studio"
  },
  "homepage": "https://github.com/rotkiv93/bango/tree/main/packages/studio#readme",
  "bugs": {
    "url": "https://github.com/rotkiv93/bango/issues"
  },
  "keywords": [
    "bango",
    "metamodel",
    "langium",
    "editor",
    "monaco"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": "./dist/bundle/studio.js"
  },
  "peerDependencies": {
    "@bango/core": "^0.1.0",
    "@bango/renderer": "^0.1.0",
    "monaco-editor": "^0.57.0"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build && vite build -c vite.bundle.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@bango/engine": "^0.1.0"
  }
}
