{
  "name": "bango",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/playground",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:libs": "npm run build -w @bango/core && npm run build -w @bango/composer && npm run build -w @bango/engine && npm run build -w @bango/renderer",
    "build": "npm run build:libs && npm run build -w @bango/playground",
    "example": "node examples/serve.mjs",
    "pages": "npm run build -w @bango/playground",
    "pages:preview": "npm run preview -w @bango/playground"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "comlink": "^4.4.2",
    "elkjs": "^0.12.0",
    "happy-dom": "^20.14.5",
    "langium": "^4.4.0",
    "monaco-editor": "^0.57.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
