gismodel

tilelayer base label "base" url "http://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

geojsonlayer buoy-layer label "Buoy"
  entity Buoy
  defaultStyle grayPoint
  availableStyles grayPoint, level, temperature

geojsonlayer Port label "Port"
  entity Port
  defaultStyle grayPolygon
  availableStyles grayPolygon

geojsonstyle grayPoint fillColor "#808080" strokeColor "#808080" fillOpacity 1 strokeOpacity 1 radius 3
geojsonstyle greenPoint fillColor "#008000" strokeColor "#008000" fillOpacity 1 strokeOpacity 1 radius 3
geojsonstyle redPoint fillColor "#FF0000" strokeColor "#FF0000" fillOpacity 1 strokeOpacity 1 radius 3
geojsonstyle grayPolygon fillColor "#808080" strokeColor "#808080" fillOpacity 0.5 strokeOpacity 1 radius 3

intervalstyle level property "data.level"
  from -Infinity to 2 style greenPoint
  from 2 to Infinity style redPoint
  defaultStyle grayPoint
intervalstyle temperature property "data.temperature"
  from -Infinity to 25 style greenPoint
  from 25 to Infinity style redPoint
  defaultStyle grayPoint

map buoys-map label "Buoys" center 43.3 -8.4 zoom 10 {
  use base baseLayer selected order 0
  use buoy-layer style grayPoint selected order 1
  use Port style grayPolygon order 2
}
