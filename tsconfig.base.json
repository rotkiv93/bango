{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@bango/composer": ["./packages/composer/src/index.ts"],
      "@bango/engine": ["./packages/engine/src/index.ts"],
      "@bango/engine/worker": ["./packages/engine/src/worker/index.ts"],
      "@bango/renderer": ["./packages/renderer/src/index.ts"],
      "@bango/renderer/text": ["./packages/renderer/src/views/text/index.ts"]
    }
  }
}
